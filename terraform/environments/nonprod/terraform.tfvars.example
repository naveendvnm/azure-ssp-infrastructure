environment  = "nonprod"
location     = "eastus"
project_name = "azure-ssp"

# Leave empty to derive the resource group name.
resource_group_name = ""

tags = {
  ManagedBy   = "Terraform"
  Project     = "Azure-SSP"
  Environment = "nonprod"
  Owner       = "CloudPlatform"
}

# These must be globally unique / environment-specific.
storage_account_name = "REPLACE_WITH_UNIQUE_STORAGE_NAME"
key_vault_name       = "REPLACE_WITH_UNIQUE_KEYVAULT_NAME"

# Example only. Do NOT commit a real private/public key.
ssh_public_key = "REPLACE_WITH_SSH_PUBLIC_KEY"